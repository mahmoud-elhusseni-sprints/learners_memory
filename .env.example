# ---- app ----
ENV=local
LOG_LEVEL=INFO
API_PORT=8000

# ---- postgres ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/learner_memory

# ---- redis / celery ----
REDIS_URL=redis://redis:6379/0

# ---- qdrant ----
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=learner_memory_v1

# ---- supabase storage (single bucket) ----
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=learner-evidence

# ---- LLM via LiteLLM proxy ----
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-litellm-master-key
LLM_MODEL=claude-sonnet-5
LLM_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENCY=8
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024

# ---- langfuse tracing ----
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=true

# ---- auth ----
JWT_ISSUER=https://auth.learn-os.local
JWT_JWKS_URL=https://auth.learn-os.local/.well-known/jwks.json
JWT_AUDIENCE=learner-memory
AUTH_DISABLED=false

# ---- domain tuning ----
TAXONOMY_VERSION=1
PROFILE_DEBOUNCE_SECONDS=300
EVIDENCE_WINDOW_MONTHS=18
DECAY_HALF_LIFE_DAYS=120
